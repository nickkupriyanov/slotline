{
  "name": "@nickkupriyanov/slotline-angular",
  "version": "0.0.0",
  "description": "Angular binding of Slotline: a standalone booking widget and a headless service over the shared @nickkupriyanov/slotline-core controller.",
  "keywords": [
    "angular",
    "booking",
    "scheduler",
    "scheduling",
    "calendar",
    "appointment",
    "meeting",
    "timeslots",
    "widget",
    "signals"
  ],
  "license": "MIT",
  "author": "Nick Kupriyanov",
  "homepage": "https://github.com/nickkupriyanov/slotline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickkupriyanov/slotline.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/nickkupriyanov/slotline/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/postbuild.mjs",
    "test": "node scripts/clean-specs.mjs && ngc -p tsconfig.aot-spec.json && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nickkupriyanov/slotline-core": "workspace:^",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/forms": "^21.0.0 || ^22.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/compiler-cli": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/forms": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "ng-packagr": "21.2.7",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
